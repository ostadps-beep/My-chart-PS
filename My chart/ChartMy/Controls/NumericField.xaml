<UserControl x:Class="ChartMy.Controls.NumericField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32" Width="120" HorizontalAlignment="Left">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ValueBox" Grid.Column="0" VerticalContentAlignment="Center" LostFocus="ValueBox_LostFocus"/>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <RepeatButton Grid.Row="0" Content="▴" FontSize="8" Click="Up_Click" Padding="0" Margin="1,0,0,0"/>
            <RepeatButton Grid.Row="1" Content="▾" FontSize="8" Click="Down_Click" Padding="0" Margin="1,0,0,0"/>
        </Grid>
    </Grid>
</UserControl>
