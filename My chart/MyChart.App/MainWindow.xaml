<Window x:Class="MyChart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chart="clr-namespace:MyChart.UI.Chart;assembly=MyChart.UI"
        Title="MyChart"
        Height="720"
        Width="1280"
        Background="#1E1E1E"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="OnLoaded">
  <Window.Resources>
    <!-- ChartMy palette -->
    <Style x:Key="ThemeChromeButton" TargetType="Button">
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#444444"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="4"
                    Padding="8,0">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#C42B1C"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="Menu">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="0"/>
    </Style>

    <Style TargetType="MenuItem">
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="10,4"/>
      <Style.Triggers>
        <Trigger Property="IsHighlighted" Value="True">
          <Setter Property="Background" Value="#3A3A3A"/>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#333333" BorderThickness="1" Background="#1E1E1E">
    <DockPanel>

      <!-- ===== Title bar (app name + window controls) ===== -->
      <Border DockPanel.Dock="Top"
              Background="#1E1E1E"
              BorderBrush="#333333"
              BorderThickness="0,0,0,1"
              MouseLeftButtonDown="OnTitleBarDrag">
        <Grid Height="30">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
            <TextBlock Text="MyChart"
                       Foreground="#FFFFFF"
                       FontSize="12"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>
            <TextBlock Text="  ·  Chart"
                       Foreground="#AAAAAA"
                       FontSize="11"
                       VerticalAlignment="Center"/>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal">
            <Button Content="─" Style="{StaticResource CaptionButton}" Click="OnMinimize"/>
            <Button Content="☐" Style="{StaticResource CaptionButton}" Click="OnMaximize"/>
            <Button Content="✕" Style="{StaticResource CaptionCloseButton}" Click="OnClose"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- ===== Menu bar (modules / future projects) ===== -->
      <Border DockPanel.Dock="Top"
              Background="#252525"
              BorderBrush="#333333"
              BorderThickness="0,0,0,1">
        <Grid Height="32">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <Menu Grid.Column="0" VerticalAlignment="Center" Margin="4,0,0,0">
            <MenuItem Header="_File">
              <MenuItem Header="_Settings..." Click="OnSettingsClick"/>
              <Separator/>
              <MenuItem Header="E_xit" Click="OnClose"/>
            </MenuItem>
            <MenuItem Header="_View">
              <MenuItem Header="Chart" IsEnabled="True"/>
            </MenuItem>
            <MenuItem Header="_Tools">
              <MenuItem Header="Settings..." Click="OnSettingsClick"/>
            </MenuItem>
            <!-- Placeholder for future projects/modules -->
            <MenuItem Header="_Modules">
              <MenuItem Header="(coming soon)" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Help">
              <MenuItem Header="About MyChart" IsEnabled="False"/>
            </MenuItem>
          </Menu>

          <Button Grid.Column="1"
                  Content="Settings"
                  Style="{StaticResource ThemeChromeButton}"
                  Width="90"
                  Height="24"
                  Margin="0,0,8,0"
                  VerticalAlignment="Center"
                  Click="OnSettingsClick"/>
        </Grid>
      </Border>

      <chart:ChartHost x:Name="Chart" />
    </DockPanel>
  </Border>
</Window>
