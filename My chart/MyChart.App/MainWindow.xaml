<Window x:Class="MyChart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chart="clr-namespace:MyChart.UI.Chart;assembly=MyChart.UI"
        Title="MyChart"
        Height="720"
        Width="1280"
        Background="#1E1E1E"
        Loaded="OnLoaded">
  <DockPanel>
    <!-- ChartMy palette: Panel #252525, Control #2A2A2A, Accent #4CAF50, Text #FFFFFF, Muted #AAAAAA -->
    <Border DockPanel.Dock="Top" Background="#252525" BorderBrush="#333333" BorderThickness="0,0,0,1" Padding="8,6">
      <StackPanel Orientation="Horizontal">
        <Button Content="Settings"
                Width="100"
                Height="28"
                Margin="0,0,12,0"
                Click="OnSettingsClick"
                Background="#2A2A2A"
                Foreground="#FFFFFF"
                BorderBrush="#444444"
                BorderThickness="1"
                Cursor="Hand"/>
        <TextBlock Text="MyChart"
                   VerticalAlignment="Center"
                   Foreground="#AAAAAA"
                   FontSize="14"/>
      </StackPanel>
    </Border>
    <chart:ChartHost x:Name="Chart" />
  </DockPanel>
</Window>
