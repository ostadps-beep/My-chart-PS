<Window x:Class="MyChart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chart="clr-namespace:MyChart.UI.Chart;assembly=MyChart.UI"
        Title="MyChart"
        Height="720"
        Width="1280"
        Background="#1E1E1E"
        WindowStyle="None"
        ResizeMode="CanResize"
        Loaded="OnLoaded">
  <Window.Resources>
    <Style x:Key="TbButton" TargetType="Button">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#FFFFFF"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="MinWidth" Value="36"/>
      <Setter Property="Padding" Value="8,0"/>
      <Setter Property="Margin" Value="2,0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                    CornerRadius="3" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#505050"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="LeftTbButton" TargetType="Button" BasedOn="{StaticResource TbButton}">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="2"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="ToolTip" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
    </Style>
    <Style x:Key="CaptionButton" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="28"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="#AAAAAA"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A"/>
                <Setter Property="Foreground" Value="#FFFFFF"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Border BorderBrush="#333333" BorderThickness="1" Background="#1E1E1E">
    <DockPanel Background="#1E1E1E">
      <!-- Caption (window chrome only) -->
      <Border DockPanel.Dock="Top" Background="#1E1E1E" Height="28"
              MouseLeftButtonDown="OnTitleBarDrag">
        <Grid>
          <TextBlock Text="MyChart" Foreground="#FFFFFF" FontSize="11" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="─" Style="{StaticResource CaptionButton}" Click="OnMinimize"/>
            <Button Content="☐" Style="{StaticResource CaptionButton}" Click="OnMaximize"/>
            <Button Content="✕" Style="{StaticResource CaptionButton}" Click="OnClose"/>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 1. TOP TOOLBAR (32 DIP) — from TopToolbarModel -->
      <Border DockPanel.Dock="Top" Background="#1E1E1E" Height="32"
              BorderBrush="#333333" BorderThickness="0,0,0,1">
        <DockPanel>
          <ItemsControl x:Name="TopToolbarHost" Margin="4,0">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </DockPanel>
      </Border>

      <!-- 6+7 TAB + STATUS -->
      <Border DockPanel.Dock="Bottom" Background="#1E1E1E" Height="28"
              BorderBrush="#333333" BorderThickness="0,1,0,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <!-- 6. Tab bar -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
            <Border Background="#2A2A2A" CornerRadius="3,3,0,0" Padding="12,4" Margin="0,0,4,0">
              <TextBlock Text="EURUSD M1" Foreground="#FFFFFF" FontSize="11"/>
            </Border>
          </StackPanel>
          <!-- 7. Status bar -->
          <TextBlock x:Name="StatusText" Grid.Column="1" VerticalAlignment="Center"
                     Margin="0,0,12,0" Foreground="#AAAAAA" FontSize="11"
                     Text="Ready"/>
        </Grid>
      </Border>

      <!-- Body: 2. LEFT TOOLBAR + 3. CHART (axes inside ChartHost) -->
      <DockPanel>
        <Border DockPanel.Dock="Left" Width="36" Background="#1E1E1E"
                BorderBrush="#333333" BorderThickness="0,0,1,0">
          <ItemsControl x:Name="LeftToolbarHost" Margin="0,4">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Vertical" HorizontalAlignment="Center"/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </Border>
        <chart:ChartHost x:Name="Chart"/>
      </DockPanel>
    </DockPanel>
  </Border>
</Window>
