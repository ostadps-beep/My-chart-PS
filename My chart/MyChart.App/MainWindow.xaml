<Window x:Class="MyChart.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chart="clr-namespace:MyChart.UI.Chart;assembly=MyChart.UI"
        Title="MyChart"
        Height="720"
        Width="1280"
        Background="#131722"
        Loaded="OnLoaded">
  <DockPanel>
    <!-- T6.08 temporary entry until full TopToolbar chrome is hosted in UI -->
    <Menu DockPanel.Dock="Top" Background="#1E222D" Foreground="#D1D4DC">
      <MenuItem Header="_Settings" Click="OnSettingsClick" />
    </Menu>
    <chart:ChartHost x:Name="Chart" />
  </DockPanel>
</Window>
