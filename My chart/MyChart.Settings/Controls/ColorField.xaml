<UserControl x:Class="MyChart.Settings.Controls.ColorField"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="32">
    <UserControl.Resources>
        <DrawingBrush x:Key="CheckerBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF888888">
                        <GeometryDrawing.Geometry>
                            <RectangleGeometry Rect="0,0,8,8"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#FFCCCCCC">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,4,4"/>
                                <RectangleGeometry Rect="4,4,4,4"/>
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="32"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="28"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Margin="0,0,6,0" BorderBrush="#444" BorderThickness="1" CornerRadius="4"
                Background="{StaticResource CheckerBrush}">
            <Border x:Name="Swatch" CornerRadius="3" Background="#FFFFFF"/>
        </Border>
        <TextBox x:Name="HexBox" Grid.Column="1" VerticalContentAlignment="Center" LostFocus="HexBox_LostFocus"/>
        <ToggleButton x:Name="PickerButton" Grid.Column="2" Margin="6,0,0,0" Content="…" Focusable="False"
                      Checked="PickerButton_Checked"/>
        <Popup PlacementTarget="{Binding ElementName=PickerButton}" Placement="Bottom"
               IsOpen="{Binding IsChecked, ElementName=PickerButton}" StaysOpen="False">
            <Border Background="#2A2A2A" BorderBrush="#444" BorderThickness="1" Padding="12" Width="280">
                <StackPanel>
                    <Grid Height="56" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="56"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Preview" Foreground="#AAAAAA" VerticalAlignment="Top"/>
                        <Border Grid.Column="1" BorderBrush="#444" BorderThickness="1" CornerRadius="4"
                                Background="{StaticResource CheckerBrush}">
                            <Border x:Name="PreviewSwatch" CornerRadius="3" Background="#FFFFFF"/>
                        </Border>
                    </Grid>

                    <TextBlock Text="Spectrum" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                    <Grid x:Name="SvHost" Height="140" Margin="0,0,0,8"
                          MouseLeftButtonDown="SvHost_MouseLeftButtonDown"
                          MouseMove="SvHost_MouseMove"
                          MouseLeftButtonUp="SvHost_MouseLeftButtonUp">
                        <Image x:Name="SvImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="SvMarker" Width="12" Height="12" Stroke="White" StrokeThickness="2"
                                     Fill="Transparent"/>
                        </Canvas>
                    </Grid>

                    <TextBlock Text="Hue" Foreground="#AAAAAA" Margin="0,0,0,4"/>
                    <Grid x:Name="HueHost" Height="16" Margin="0,0,0,10"
                          MouseLeftButtonDown="HueHost_MouseLeftButtonDown"
                          MouseMove="HueHost_MouseMove"
                          MouseLeftButtonUp="HueHost_MouseLeftButtonUp">
                        <Image x:Name="HueImage" Stretch="Fill"/>
                        <Canvas IsHitTestVisible="False">
                            <Rectangle x:Name="HueMarker" Width="3" Height="16" Fill="White" Stroke="#333" StrokeThickness="1"/>
                        </Canvas>
                    </Grid>

                    <TextBlock Text="Saturation" Foreground="White" Margin="0,0,0,2"/>
                    <Slider x:Name="SatSlider" Minimum="0" Maximum="100" ValueChanged="SatSlider_ValueChanged"/>
                    <TextBlock Text="Brightness" Foreground="White" Margin="0,8,0,2"/>
                    <Slider x:Name="BrightSlider" Minimum="0" Maximum="100" ValueChanged="BrightSlider_ValueChanged"/>

                    <TextBlock Text="R" Foreground="White" Margin="0,10,0,2"/>
                    <Slider x:Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="Channel_ValueChanged"/>
                    <TextBlock Text="G" Foreground="White" Margin="0,8,0,2"/>
                    <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="Channel_ValueChanged"/>
                    <TextBlock Text="B" Foreground="White" Margin="0,8,0,2"/>
                    <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="Channel_ValueChanged"/>
                    <TextBlock Text="Alpha / Transparency" Foreground="White" Margin="0,8,0,2"/>
                    <Slider x:Name="AlphaSlider" Minimum="0" Maximum="255" ValueChanged="Channel_ValueChanged"/>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>

