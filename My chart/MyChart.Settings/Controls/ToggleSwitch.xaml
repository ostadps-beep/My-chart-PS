<UserControl x:Class="MyChart.Settings.Controls.ToggleSwitch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="60" Height="28">
    <Grid x:Name="Root" Cursor="Hand" MouseLeftButtonUp="Root_MouseLeftButtonUp">
        <Border x:Name="Track" CornerRadius="4" Background="#616161" BorderBrush="#444" BorderThickness="1"/>
        <Ellipse x:Name="Thumb" Width="20" Height="20" Margin="4" Fill="White" HorizontalAlignment="Left"/>
        <TextBlock x:Name="StateText" Text="OFF" Foreground="White" FontSize="9"
                   HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
    </Grid>
</UserControl>

