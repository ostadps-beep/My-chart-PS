<Window x:Class="MyChart.Settings.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:MyChart.Settings.Controls"
        xmlns:views="clr-namespace:MyChart.Settings.Views"
        Title="Settings"
        Width="920" Height="700"
        MinWidth="820" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MyChart.Settings;component/Themes/Dark.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <views:FieldTemplateSelector x:Key="FieldSelector">
                <views:FieldTemplateSelector.Dropdown>
                    <DataTemplate>
                        <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding StringValue, Mode=TwoWay}"
                                  IsEnabled="{Binding IsEnabled}"/>
                    </DataTemplate>
                </views:FieldTemplateSelector.Dropdown>
                <views:FieldTemplateSelector.Slider>
                    <DataTemplate>
                        <Grid IsEnabled="{Binding IsEnabled}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="40"/>
                            </Grid.ColumnDefinitions>
                            <Slider Minimum="{Binding Min}" Maximum="{Binding Max}"
                                    Value="{Binding DoubleValue, Mode=TwoWay}"
                                    TickFrequency="1" IsSnapToTickEnabled="True"/>
                            <TextBlock Grid.Column="1" Text="{Binding IntValue}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </views:FieldTemplateSelector.Slider>
                <views:FieldTemplateSelector.Numeric>
                    <DataTemplate>
                        <controls:NumericField Value="{Binding IntValue, Mode=TwoWay}"
                                               Minimum="{Binding Min}" Maximum="{Binding Max}"
                                               Increment="{Binding Definition.Increment}"
                                               IsEnabled="{Binding IsEnabled}"/>
                    </DataTemplate>
                </views:FieldTemplateSelector.Numeric>
                <views:FieldTemplateSelector.Toggle>
                    <DataTemplate>
                        <controls:ToggleSwitch IsOn="{Binding BoolValue, Mode=TwoWay}" IsEnabled="{Binding IsEnabled}"
                                               HorizontalAlignment="Left"/>
                    </DataTemplate>
                </views:FieldTemplateSelector.Toggle>
                <views:FieldTemplateSelector.Color>
                    <DataTemplate>
                        <controls:ColorField HexValue="{Binding StringValue, Mode=TwoWay}"
                                             IsEnabled="{Binding IsEnabled}" MaxWidth="180" HorizontalAlignment="Left"/>
                    </DataTemplate>
                </views:FieldTemplateSelector.Color>
                <views:FieldTemplateSelector.Text>
                    <DataTemplate>
                        <TextBox Text="{Binding StringValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 IsEnabled="{Binding IsEnabled}" Width="240" HorizontalAlignment="Left"/>
                    </DataTemplate>
                </views:FieldTemplateSelector.Text>
                <views:FieldTemplateSelector.CheckList>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding CheckOptions}" IsEnabled="{Binding IsEnabled}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsChecked, Mode=TwoWay}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </views:FieldTemplateSelector.CheckList>
                <views:FieldTemplateSelector.ParameterList>
                    <DataTemplate>
                        <StackPanel IsEnabled="{Binding IsEnabled}">
                            <ItemsControl ItemsSource="{Binding Parameters}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0" Margin="0,0,6,0" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBox Grid.Column="1" Margin="0,0,6,0" Text="{Binding Value, UpdateSourceTrigger=LostFocus}"/>
                                            <Button Grid.Column="2" Content="Remove" MinWidth="80" Width="80"
                                                    Command="{Binding RemoveCommand}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Add Parameter" Command="{Binding AddParameterCommand}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </views:FieldTemplateSelector.ParameterList>
                <views:FieldTemplateSelector.Command>
                    <DataTemplate>
                        <StackPanel>
                            <Button Content="Run" Command="{Binding Command}" IsEnabled="{Binding IsEnabled}"/>
                            <TextBlock Text="{Binding Hint}" Foreground="#AAAAAA" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </DataTemplate>
                </views:FieldTemplateSelector.Command>
            </views:FieldTemplateSelector>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0" Grid.Column="0" Background="#252525" BorderBrush="#333" BorderThickness="0,0,1,0">
            <ListBox ItemsSource="{Binding Categories}"
                     SelectedItem="{Binding SelectedCategory}"
                     DisplayMemberPath="Name"/>
        </Border>

        <Grid Grid.Row="0" Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Padding="16,14" BorderBrush="#333" BorderThickness="0,0,0,1">
                <StackPanel>
                    <TextBlock Text="{Binding HeaderTitle}" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding HeaderDescription}" Foreground="#AAAAAA" Margin="0,6,0,0" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" Padding="12" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding SelectedCategory.Groups}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <GroupBox Header="{Binding Name}">
                                <ItemsControl ItemsSource="{Binding Fields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Top" Margin="0,8,12,0" TextWrapping="Wrap"/>
                                                <ContentPresenter Grid.Column="1" Content="{Binding}"
                                                                  ContentTemplateSelector="{StaticResource FieldSelector}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </GroupBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="#252525" BorderBrush="#333" BorderThickness="0,1,0,0" Padding="12">
            <Grid>
                <TextBlock Text="{Binding StatusText}" Foreground="#AAAAAA" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource FooterButton}" Content="Apply" Command="{Binding ApplyCommand}"/>
                    <Button Style="{StaticResource FooterButton}" Content="OK" Command="{Binding OkCommand}"/>
                    <Button Style="{StaticResource FooterButton}" Content="Cancel" Command="{Binding CancelCommand}"/>
                    <Button Style="{StaticResource FooterButton}" Content="Reset to Default" Width="140"
                            Command="{Binding ResetCommand}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
