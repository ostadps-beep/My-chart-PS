<Window x:Class="MyChart.ToolBuilder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyChart Tool Builder"
        Height="640"
        Width="960">
  <DockPanel Margin="12">
    <TextBlock DockPanel.Dock="Top" FontSize="18" FontWeight="SemiBold"
               Text="Tool Definition (PG6.01)" Margin="0,0,0,12"/>
    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
      <Button x:Name="SaveButton" Content="Save" Width="100" Height="28" Click="SaveButton_OnClick"/>
    </StackPanel>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="2*"/>
        <ColumnDefinition Width="12"/>
        <ColumnDefinition Width="3*"/>
      </Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
        <TextBlock Text="Name"/>
        <TextBox x:Name="NameBox" Margin="0,4,0,8"/>
        <TextBlock Text="Anchors"/>
        <TextBox x:Name="AnchorsBox" Text="2" Margin="0,4,0,8"/>
        <TextBlock Text="Workflow"/>
        <ComboBox x:Name="WorkflowBox" Margin="0,4,0,8">
          <ComboBoxItem Content="Click" IsSelected="True"/>
          <ComboBoxItem Content="ClickThenText"/>
        </ComboBox>
        <TextBlock Text="Shapes"/>
        <ListBox x:Name="ShapesList" Height="160" Margin="0,4,0,8"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="Add Line" Margin="0,0,8,0" Click="AddLine_OnClick"/>
          <Button Content="Remove" Click="RemoveShape_OnClick"/>
        </StackPanel>
        <TextBlock x:Name="ErrorText" Foreground="IndianRed" TextWrapping="Wrap" Margin="0,12,0,0"/>
      </StackPanel>
      <TextBox Grid.Column="2" x:Name="JsonPreview" IsReadOnly="True"
               FontFamily="Consolas" VerticalScrollBarVisibility="Auto"
               HorizontalScrollBarVisibility="Auto" AcceptsReturn="True"/>
    </Grid>
  </DockPanel>
</Window>
