<UserControl x:Class="MyChart.ToolBuilder.Views.IconPickerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel Margin="8">
    <TextBlock DockPanel.Dock="Top" Text="Icon Picker (PG6.03)" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock DockPanel.Dock="Bottom" x:Name="StatusText" Margin="0,8,0,0" TextWrapping="Wrap"/>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <ListBox x:Name="IconList" Grid.Row="0"/>
      <StackPanel Grid.Row="1" Margin="0,8,0,0">
        <TextBlock Text="Paste SVG path data"/>
        <TextBox x:Name="PathBox" Height="48" AcceptsReturn="True" TextWrapping="Wrap"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</UserControl>
